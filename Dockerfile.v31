FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8001
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Canonical files remain unmodified and available for an explicit rollback image.
COPY api.py predict_real.py evaluate_forecasts.py ./
COPY bookings_model.joblib guests_model.joblib forecast_models_metadata.json bookings_model_metadata.json ./
COPY Dockerfile ./
COPY experiments/reserVision_v3_1_two_stage_rc_20261124/ ./experiments/reserVision_v3_1_two_stage_rc_20261124/
COPY production_v31/ ./production_v31/
ENV PREDICTION_ARTIFACT_DIR=/app/experiments/reserVision_v3_1_two_stage_rc_20261124/artifacts
RUN python -B -m production_v31.verify_release
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=3 \
  CMD ["python", "-B", "-m", "production_v31.healthcheck"]
CMD ["python", "-B", "-m", "production_v31.serve"]
