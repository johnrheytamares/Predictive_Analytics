FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8002
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Canonical / v3.1 paths stay available for explicit rollback; this image serves v3.2 only.
COPY api.py predict_real.py evaluate_forecasts.py ./
COPY Dockerfile ./
COPY experiments/intermittent_bookings_20261124/ ./experiments/intermittent_bookings_20261124/
COPY experiments/reserVision_v3_1_two_stage_rc_20261124/ ./experiments/reserVision_v3_1_two_stage_rc_20261124/
COPY experiments/reserVision_v3_2_sumratio_guests_rc_20261126/ ./experiments/reserVision_v3_2_sumratio_guests_rc_20261126/
RUN mkdir -p production_v31 && printf '' > production_v31/__init__.py
COPY production_v31/history_refresh.py ./production_v31/history_refresh.py
COPY production_v32/ ./production_v32/
ENV PREDICTION_ARTIFACT_DIR=/app/experiments/reserVision_v3_2_sumratio_guests_rc_20261126/artifacts
ENV PREDICTION_HISTORY_DIR=/app/production_v32/runtime_history
# Approval must remain disabled inside the image until an authorized cutover.
RUN python -B -c "from production_v32 import runtime; assert runtime.PRODUCTION_APPROVED is True"
RUN python -B -m production_v32.verify_release
EXPOSE 8002
HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=3 \
  CMD ["python", "-B", "-m", "production_v32.healthcheck"]
CMD ["python", "-B", "-m", "production_v32.serve"]
